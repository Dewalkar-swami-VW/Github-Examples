name: UPDATE ACCELERATOR

on:
  schedule:
    - cron: '0 0 * * *'
  workflow_dispatch:

permissions:
  id-token: write
  contents: write
  pull-requests: write

jobs:
  update_acc_source:
    runs-on: ubuntu-latest

    steps:
    - name: Checkout repo
      uses: actions/checkout@v4
      with:
        token: ${{ secrets.GH_TOKEN }}
        ref: 'accelerator/origin'

    - name: Pull updates
      run: |
        git remote add source https://github.com/Azure-Samples/azure-search-openai-demo.git
        git pull source main
    - name: Push updates
      run: |
        git push origin
